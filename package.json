{
  "name": "reminder-mascot",
  "productName": "PurrPause",
  "version": "0.5.0",
  "description": "A friendly Windows tray companion for healthier work rhythms.",
  "author": "PurrPause contributors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:web": "vite --configLoader runner --host 0.0.0.0",
    "build": "vite build --configLoader runner && node scripts/prepare-sites-build.mjs",
    "build:desktop": "vite build --configLoader runner && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "koffi": "^2.14.1",
    "react": "19.2.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.purrpause.desktop",
    "productName": "PurrPause",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "PurrPause-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
